{
	"name": "FSMGR",
	"version": "2.2.0",
	"description": "Myanmar (Burmese) rule-driven text processing and grammar engine. Syllables, single-tone units, are the foundation. POS classification and sentence-level analysis cascading through clauses down to individual words are all built on top of syllables.",
	"author": "KaungMyatThu",
	"license": "ISC",
	"scripts": {
		"dev": "vite --config frontend/vite.config.js",
		"build": "vite build --config frontend/vite.config.js",
		"build:watch": "vite build --watch --config frontend/vite.config.js",
		"preview": "vite preview --config frontend/vite.config.js",
		"clean": "rm -rf dist"
	},
	"type": "module",
	"main": "index.js",
	"keywords": [
		"myanmar",
		"burmese",
		"unicode"
	],
	"dependencies": {
		"clsx": "2.1.1",
		"jszip": "^3.10.2",
		"framer-motion": "^12.23.12",
		"lucide-react": "^0.542.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"tailwind-merge": "3.4.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.13",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"@vitejs/plugin-react": "^4.7.0",
		"vite": "^6.0.0",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.1",
		"animejs": "^4.2.2",
		"sass-embedded": "^1.100.0",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2"
	}
}