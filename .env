# Tracked preproduction placeholders. Replace every REPLACE_* value before use.
MODE=production
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# SQLite
DB_FILE=.data/site.db

# Browser/session secrets (minimum 32 characters)
COOKIE_SECRET=REPLACE_COOKIE_SECRET_32_CHARS_MINIMUM
SESSION_SECRET=REPLACE_SESSION_SECRET_32_CHARS_MINIMUM

# Direct-hosted preproduction: no Cloudflare Worker or trusted geo proxy.
#
# TRUST_PROXY empty means req.ip is the SOCKET address. Behind any reverse
# proxy (nginx, a load balancer, Cloudflare) that is the proxy's address for
# every visitor, so the per-IP rate limits below become shared global limits
# and the 21st visitor in an hour is refused. Set TRUST_PROXY=loopback (or the
# proxy's address/CIDR) the moment anything sits in front of this process.
TRUST_PROXY=
EDGE_SECRET=
# BEFORE PUBLISHING: set COOKIE_SECURE=true, or unset it to auto-detect.
# false is correct ONLY for a plain-HTTP run; on an HTTPS host it sends session
# and identity cookies without the Secure flag. The server prints a [security]
# banner at boot whenever this is false while MODE=production.
COOKIE_SECURE=false
# 'strict' is the code default. 'lax' lets a cross-site top-level navigation
# carry these cookies; keep it only if the SPA is served from another host.
COOKIE_SAMESITE=lax
REQUIRE_MM_COUNTRY=false

# Upload/parser runtime limits
UPLOAD_MAX_MB=64
IDENTITY_RATE_WINDOW_MINUTES=60
IDENTITY_RATE_MAX=20
UPLOAD_RATE_WINDOW_MINUTES=60
UPLOAD_RATE_MAX=20
PARSER_MAX_CONCURRENCY=2
PARSER_RUNTIME_DIR=Parsed
ARTIFACT_TTL_HOURS=24
HTTP_REQUEST_TIMEOUT_MS=120000
MAX_TEXT_INPUT_CHARS=1000000
# Per-visitor uploads per day. This is configuration, honoured in production —
# not the DEV_BYPASS_QUOTA dev flag, which is inert outside MODE=development.
#   3  the default           50  generous but bounded           0  off entirely
# With 0 there is no per-visitor cap; UPLOAD_RATE_MAX (per IP, per hour) and
# PARSER_MAX_CONCURRENCY still bound the work, and the per-IP rate limit is
# already the binding constraint in practice.
DAILY_UPLOAD_LIMIT=3
PRASER_TIMEOUT_MS=120000
PRASER_WORKER_HEAP_MB=384
PRASER_MAX_PAGES=2000
PRASER_MAX_OCR_PIXELS=40000000
PRASER_MAX_OBJECTS=250000
PRASER_MAX_TEXT_CHARS=20000000
PRASER_MAX_STREAM_MB=128
PRASER_MAX_MEMBER_MB=64
PRASER_MAX_DOCX_TOTAL_MB=128
PRASER_MAX_DOCX_ENTRIES=4096
# Server-boot diagnostic scanner. This is not upload metadata: when enabled,
# every conversion worker writes one scan report beside its server-generated
# output artifact, named from the private conversion output path.
PRASER_SCAN_LOGGING=false
# Optional server-owned dictionary path; defaults to Parsed/parser/model/master.json.enc.
PRASER_SCAN_DICTIONARY=

FRONTEND_DIR=frontend/dist

# Site -> Engine bridge (all optional; the Site runs fully without them).
# Keys are 32 hexadecimal characters each, generated INDEPENDENTLY from 16
# random bytes (e.g. `openssl rand -hex 16`).
#
#   SITE_TO_ENGINE_KEY  authenticates Site hidden dispatch -> Engine
#   ENGINE_TO_SITE_KEY  authenticates Engine -> Site queue
#
# The Engine calls back at the Site queue on its own configuration; the Site
# never sends a queue URL, callback, fileUrl or public URL as job metadata.
ENGINE_JOB_URL=
SITE_TO_ENGINE_KEY=
ENGINE_TO_SITE_KEY=
ENGINE_ACCEPT_TIMEOUT_MS=3000
ENGINE_JOB_TIMEOUT_MS=120000

# Rate limit for the Engine-facing queue route (requests per window).
ENGINE_QUEUE_RATE_WINDOW_MINUTES=60
ENGINE_QUEUE_RATE_MAX=240
